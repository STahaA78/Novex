make int:a
make int:b
make int:sum1
make int:sub1
make int:prod
//input//
[
    print::: _$ Enter two numbers $_
    write::: a
    write::: b
]

//solve//
[
    operation sum,sum1,b,a
    operation sub,sub1,b,a
    operation product,prod,b,a
    a,copy,b
    b,equals?,sum1
]



//display//
[
    print::: _$ Sum is $_
    print::: sum1
]


//Main//
[
    a,copy,b
]