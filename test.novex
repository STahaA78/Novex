make int:a
make int:b
make int:sum1
make int:sub1
make int:prod
//input//
[
    print::: _$ Enter two numbers $_    
    write::: a          
    write::: b
]

//solve//
[
    operation sum,sum1,b,a 
    print:::sum1
    operation sub,sub1,a,b 
    print:::sub1
    operation product,prod,b,a
    print:::prod
    a,copy,prod
    print:::a
    a,b,equals?,sum1
    print:::a
]



//display//
[
    print::: _$ Sum is $_
    print::: sum1
]


//Main//
[
    a,copy,b
]
